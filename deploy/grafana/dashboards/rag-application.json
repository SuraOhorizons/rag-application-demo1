{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Chat Requests",
      "id": 1,
      "datasource": {
        "type": "grafana-azureprometheus-datasource",
        "uid": "azure-managed-prometheus"
      },
      "targets": [
        {
          "expr": "rag_chat_requests_total",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Requests / min",
      "id": 2,
      "datasource": {
        "type": "grafana-azureprometheus-datasource",
        "uid": "azure-managed-prometheus"
      },
      "targets": [
        {
          "expr": "rate(rag_chat_requests_total[5m]) * 60",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Documents Indexed",
      "id": 3,
      "datasource": {
        "type": "grafana-azureprometheus-datasource",
        "uid": "azure-managed-prometheus"
      },
      "targets": [
        {
          "expr": "rag_documents_indexed_total",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Average Chat Latency",
      "id": 4,
      "datasource": {
        "type": "grafana-azureprometheus-datasource",
        "uid": "azure-managed-prometheus"
      },
      "targets": [
        {
          "expr": "rate(rag_chat_latency_seconds_sum[5m]) / rate(rag_chat_latency_seconds_count[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Chat Request Rate",
      "id": 5,
      "datasource": {
        "type": "grafana-azureprometheus-datasource",
        "uid": "azure-managed-prometheus"
      },
      "targets": [
        {
          "expr": "rate(rag_chat_requests_total[5m])",
          "legendFormat": "requests/sec",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Chat Latency",
      "id": 6,
      "datasource": {
        "type": "grafana-azureprometheus-datasource",
        "uid": "azure-managed-prometheus"
      },
      "targets": [
        {
          "expr": "rate(rag_chat_latency_seconds_sum[5m]) / rate(rag_chat_latency_seconds_count[5m])",
          "legendFormat": "average latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(rag_chat_latency_seconds_bucket[5m]))",
          "legendFormat": "p95 latency",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "RAG Documents Indexed",
      "id": 7,
      "datasource": {
        "type": "grafana-azureprometheus-datasource",
        "uid": "azure-managed-prometheus"
      },
      "targets": [
        {
          "expr": "rag_documents_indexed_total",
          "legendFormat": "documents",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      }
    },
    {
      "type": "timeseries",
      "title": "Process Memory",
      "id": 8,
      "datasource": {
        "type": "grafana-azureprometheus-datasource",
        "uid": "azure-managed-prometheus"
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "RSS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      }
    }
  ],
  "schemaVersion": 41,
  "tags": [
